# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me          # superuser, only used by the init script
N8N_DB_PASSWORD=change-me            # n8n's own internal database
KB_DB_PASSWORD=change-me             # knowledge base + audit log
N8N_ENCRYPTION_KEY=change-me         # encrypts n8n credentials at rest; losing it = losing stored credentials
